#!/usr/bin/env bash
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROR_HOME="$(cd "$SELF_DIR/.." && pwd)"
export ROR_HOME

# shellcheck source=../lib/common.sh
. "$ROR_HOME/lib/common.sh"
# shellcheck source=../lib/os.sh
. "$ROR_HOME/lib/os.sh"
# shellcheck source=../lib/network.sh
. "$ROR_HOME/lib/network.sh"
# shellcheck source=../lib/logging.sh
. "$ROR_HOME/lib/logging.sh"
# shellcheck source=../lib/packages.sh
. "$ROR_HOME/lib/packages.sh"
# shellcheck source=../lib/dotfiles.sh
. "$ROR_HOME/lib/dotfiles.sh"

usage() {
  cat <<'EOF'
Room of Requirement (ror)

Discovery:
  ror doctor [--install-suggestions]
  ror info
  ror path [cheat-sheets|snippets|scripts|templates|docs|local]
  ror find [--type TYPE] <term>
  ror search [--type TYPE] <term>
  ror cheat <term>
  ror cheatsheet <term>

Troubleshooting:
  ror diagnose <baseline|system|network|systemd|ssh|tls|dns|storage|java|tomcat> [args...]
  ror diag <target> [args...]
  ror collect <target> [args...]
  ror run <script> [args...]

Portable environment:
  ror pkg list
  ror pkg suggest <profile-or-package>
  ror pkg install <profile-or-package>
  ror dotfiles status
  ror dotfiles diff [group|all]
  ror dotfiles install <group|all>
  ror dotfiles backups
  ror dotfiles restore [latest|backup-id]

Reuse/maintenance:
  ror new <template> <destination>
  ror update

Examples:
  ror doctor --install-suggestions
  ror collect baseline
  ror find --type runbook ssh
  ror pkg suggest linux-admin
  ror pkg install minimal
  ror dotfiles diff all
  ror dotfiles install bash
  ror dotfiles install all
  ror dotfiles restore latest
EOF
}

cmd_info() {
  ror_detect_os
  printf 'ROR_HOME=%s\n' "$ROR_HOME"
  printf 'OS=%s\n' "$ROR_OS"
  printf 'OS_FAMILY=%s\n' "$ROR_OS_FAMILY"
  printf 'ARCH=%s\n' "$ROR_ARCH"
  printf 'WSL=%s\n' "$ROR_WSL"
  printf 'PACKAGE_MANAGER=%s\n' "$(ror_package_manager)"
  printf 'DOTFILES_CONFIG_HOME=%s\n' "$(ror_dotfiles_config_home)"
  printf 'DOTFILES_STATE_HOME=%s\n' "$(ror_dotfiles_state_home)"
}

cmd_path() {
  case "${1:-home}" in
    home|root) printf '%s\n' "$ROR_HOME" ;;
    cheat|cheats|cheat-sheets) printf '%s\n' "$ROR_HOME/cheat-sheets" ;;
    snippet|snippets) printf '%s\n' "$ROR_HOME/snippets" ;;
    script|scripts) printf '%s\n' "$ROR_HOME/scripts" ;;
    template|templates) printf '%s\n' "$ROR_HOME/templates" ;;
    doc|docs) printf '%s\n' "$ROR_HOME/docs" ;;
    local) printf '%s\n' "$ROR_HOME/local" ;;
    *) ror_die "unknown ROR path: $1" ;;
  esac
}

check_tool() {
  local tool="$1"
  if ror_have "$tool"; then
    printf '  %-14s %s\n' "$tool" 'yes'
  else
    printf '  %-14s %s\n' "$tool" 'no'
  fi
}

doctor_item() {
  local state="$1" label="$2" detail="${3:-}"
  printf '  [%-4s] %-20s %s\n' "$state" "$label" "$detail"
}

doctor_health() {
  local disk_pct mem_pct failed sync firewall proxy reboot

  printf '\nSystem health\n'
  ror_hr

  disk_pct="$(df -P / 2>/dev/null | awk 'NR==2 {gsub(/%/, "", $5); print $5}')"
  if [[ "$disk_pct" =~ ^[0-9]+$ ]]; then
    if [ "$disk_pct" -ge 90 ]; then
      doctor_item WARN 'root filesystem' "${disk_pct}% used"
    else
      doctor_item OK 'root filesystem' "${disk_pct}% used"
    fi
  else
    doctor_item INFO 'root filesystem' 'usage unavailable'
  fi

  if [ -r /proc/meminfo ]; then
    mem_pct="$(awk '
      /^MemTotal:/ {total=$2}
      /^MemAvailable:/ {avail=$2}
      END {
        if (total > 0 && avail >= 0) printf "%.0f", ((total-avail)*100)/total
      }' /proc/meminfo)"
    if [[ "$mem_pct" =~ ^[0-9]+$ ]]; then
      if [ "$mem_pct" -ge 90 ]; then
        doctor_item WARN 'memory pressure' "${mem_pct}% used"
      else
        doctor_item OK 'memory pressure' "${mem_pct}% used"
      fi
    fi
  else
    doctor_item INFO 'memory pressure' 'Linux MemAvailable unavailable'
  fi

  if ror_have systemctl; then
    failed="$(systemctl --failed --no-legend --no-pager 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')"
    if [[ "$failed" =~ ^[0-9]+$ ]] && [ "$failed" -gt 0 ]; then
      doctor_item WARN 'failed systemd units' "$failed"
    else
      doctor_item OK 'failed systemd units' "${failed:-0}"
    fi
  else
    doctor_item INFO 'failed services' 'systemctl unavailable'
  fi

  if ror_have timedatectl; then
    sync="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    case "$sync" in
      yes) doctor_item OK 'time synchronization' 'synchronized' ;;
      no) doctor_item WARN 'time synchronization' 'not synchronized' ;;
      *) doctor_item INFO 'time synchronization' 'status unavailable' ;;
    esac
  elif ror_have chronyc; then
    if chronyc tracking >/dev/null 2>&1; then
      doctor_item OK 'time synchronization' 'chrony responding'
    else
      doctor_item WARN 'time synchronization' 'chrony check failed'
    fi
  else
    doctor_item INFO 'time synchronization' 'no supported status tool'
  fi

  if ror_have getenforce; then
    doctor_item INFO 'SELinux' "$(getenforce 2>/dev/null || printf unknown)"
  elif ror_have aa-status; then
    doctor_item INFO 'AppArmor' 'status tool available'
  else
    doctor_item INFO 'MAC security' 'SELinux/AppArmor status tool absent'
  fi

  if ror_have firewall-cmd; then
    firewall="$(firewall-cmd --state 2>/dev/null || printf inactive)"
    [ "$firewall" = 'running' ] && doctor_item OK 'firewall' 'firewalld running' || doctor_item WARN 'firewall' "firewalld ${firewall}"
  elif ror_have ufw; then
    firewall="$(ufw status 2>/dev/null | head -1 || true)"
    doctor_item INFO 'firewall' "${firewall:-ufw status unavailable}"
  else
    doctor_item INFO 'firewall' 'no supported firewall CLI found'
  fi

  proxy='no'
  for name in HTTP_PROXY HTTPS_PROXY http_proxy https_proxy; do
    [ -n "${!name:-}" ] && proxy='yes'
  done
  doctor_item INFO 'proxy environment' "configured: $proxy"

  reboot='unknown'
  if [ -f /var/run/reboot-required ]; then
    reboot='required'
  elif ror_have needs-restarting; then
    if needs-restarting -r >/dev/null 2>&1; then
      reboot='not required'
    else
      reboot='required or check failed'
    fi
  fi
  case "$reboot" in
    required|'required or check failed') doctor_item WARN 'reboot status' "$reboot" ;;
    'not required') doctor_item OK 'reboot status' "$reboot" ;;
    *) doctor_item INFO 'reboot status' "$reboot" ;;
  esac
}

cmd_doctor() {
  local suggestions='no'
  [ "${1:-}" = '--install-suggestions' ] && suggestions='yes'
  ror_detect_os

  printf 'Room of Requirement\n'
  ror_hr
  printf 'Home:       %s\n' "$ROR_HOME"
  printf 'OS:         %s (%s)\n' "$ROR_OS" "$ROR_OS_FAMILY"
  printf 'Arch:       %s\n' "$ROR_ARCH"
  printf 'WSL:        %s\n' "$ROR_WSL"
  printf 'Shell:      %s\n' "${SHELL:-unknown}"
  printf 'User:       %s\n' "$(id -un 2>/dev/null || printf unknown)"
  printf 'Root:       %s\n' "$([ "$(id -u 2>/dev/null || printf 1)" -eq 0 ] && printf yes || printf no)"
  printf 'sudo:       %s\n' "$(ror_yesno command -v sudo)"
  printf 'Pkg mgr:    %s\n' "$(ror_package_manager)"
  printf 'Primary IP: %s\n' "$(ror_primary_ip || true)"
  printf 'Gateway:    %s\n' "$(ror_default_gateway || true)"

  if ror_have systemd-detect-virt; then
    printf 'Virt:       %s\n' "$(systemd-detect-virt 2>/dev/null || printf none)"
  fi

  doctor_health

  printf '\nTools\n'
  ror_hr
  for tool in git curl wget jq dig nc openssl ssh python3 ansible docker podman kubectl helm govc gcloud lsof strace tcpdump traceroute tmux; do
    check_tool "$tool"
  done

  printf '\nDotfiles\n'
  ror_hr
  ror_dotfiles_status

  printf '\nRepository\n'
  ror_hr
  if ror_have git && git -C "$ROR_HOME" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '  branch         %s\n' "$(git -C "$ROR_HOME" branch --show-current 2>/dev/null || true)"
    if [ -n "$(git -C "$ROR_HOME" status --porcelain 2>/dev/null)" ]; then
      printf '  worktree       dirty\n'
    else
      printf '  worktree       clean\n'
    fi
    printf '  commit         %s\n' "$(git -C "$ROR_HOME" rev-parse --short HEAD 2>/dev/null || true)"
  else
    printf '  git metadata unavailable\n'
  fi

  if [ "$suggestions" = 'yes' ]; then
    printf '\nInstall suggestions\n'
    ror_hr
    cmd_pkg suggest troubleshooting
  fi
}

find_in_root() {
  local label="$1" root="$2" term="$3"
  [ -d "$root" ] || return 0
  local matches
  matches="$({ find "$root" -type f 2>/dev/null | grep -i -- "$term" || true; grep -RIl -i --exclude-dir=.git -- "$term" "$root" 2>/dev/null || true; } | sed "s#^$ROR_HOME/##" | sort -u)"
  if [ -n "$matches" ]; then
    printf '%s\n' "$label"
    printf '%s\n' "$matches" | sed 's/^/  /'
    printf '\n'
  fi
}

cmd_find() {
  local type='all'
  if [ "${1:-}" = '--type' ]; then
    type="${2:-}"
    shift 2 || true
  fi
  local term="${1:-}"
  [ -n "$term" ] || ror_die 'find requires a search term'
  ror_have grep || ror_die 'grep is required for search'

  case "$type" in
    all)
      find_in_root 'CHEAT SHEETS' "$ROR_HOME/cheat-sheets" "$term"
      find_in_root 'SNIPPETS' "$ROR_HOME/snippets" "$term"
      find_in_root 'DIAGNOSTICS / SCRIPTS' "$ROR_HOME/scripts" "$term"
      find_in_root 'RUNBOOKS / DOCS' "$ROR_HOME/docs" "$term"
      find_in_root 'TEMPLATES' "$ROR_HOME/templates" "$term"
      ;;
    cheat|cheats|cheat-sheet|cheat-sheets) find_in_root 'CHEAT SHEETS' "$ROR_HOME/cheat-sheets" "$term" ;;
    snippet|snippets) find_in_root 'SNIPPETS' "$ROR_HOME/snippets" "$term" ;;
    diagnostic|diagnostics) find_in_root 'DIAGNOSTICS' "$ROR_HOME/scripts/diagnostics" "$term" ;;
    script|scripts) find_in_root 'SCRIPTS' "$ROR_HOME/scripts" "$term" ;;
    runbook|runbooks) find_in_root 'RUNBOOKS' "$ROR_HOME/docs/runbooks" "$term" ;;
    doc|docs) find_in_root 'DOCS' "$ROR_HOME/docs" "$term" ;;
    template|templates) find_in_root 'TEMPLATES' "$ROR_HOME/templates" "$term" ;;
    *) ror_die "unknown find type: $type" ;;
  esac
}

cmd_cheat() {
  local term="${1:-}"
  [ -n "$term" ] || ror_die 'cheat requires a search term'
  local matches count
  matches="$(find "$ROR_HOME/cheat-sheets" -type f -name '*.md' 2>/dev/null | grep -i -- "$term" || true)"
  if [ -z "$matches" ]; then
    matches="$(grep -RIl -i --include='*.md' -- "$term" "$ROR_HOME/cheat-sheets" 2>/dev/null || true)"
  fi
  [ -n "$matches" ] || ror_die "no cheat sheet matched: $term"
  count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [ "$count" -eq 1 ]; then
    ${PAGER:-cat} "$matches"
  else
    printf '%s\n' "$matches" | sed "s#^$ROR_HOME/##"
  fi
}

cmd_run() {
  local target="${1:-}"
  [ -n "$target" ] || ror_die 'run requires a script path under scripts/'
  shift || true
  target="${target#scripts/}"
  local path="$ROR_HOME/scripts/$target"
  [ -f "$path" ] || ror_die "script not found: scripts/$target"
  case "$path" in
    *.sh) bash "$path" "$@" ;;
    *.py) ror_have python3 || ror_die 'python3 is required'; python3 "$path" "$@" ;;
    *.ps1) ror_have pwsh || ror_die 'pwsh is required'; pwsh -File "$path" "$@" ;;
    *) "$path" "$@" ;;
  esac
}

diagnostic_script() {
  case "$1" in
    baseline|intake) printf '%s\n' 'diagnostics/baseline.sh' ;;
    system) printf '%s\n' 'diagnostics/system-info.sh' ;;
    network) printf '%s\n' 'diagnostics/network-info.sh' ;;
    systemd|service) printf '%s\n' 'diagnostics/systemd-service.sh' ;;
    ssh|sshd) printf '%s\n' 'diagnostics/ssh-server.sh' ;;
    tls|ssl|certificate|cert) printf '%s\n' 'diagnostics/tls-endpoint.sh' ;;
    dns) printf '%s\n' 'diagnostics/dns.sh' ;;
    storage|disk|filesystem|fs) printf '%s\n' 'diagnostics/storage.sh' ;;
    java|jvm) printf '%s\n' 'diagnostics/java-process.sh' ;;
    tomcat) printf '%s\n' 'diagnostics/tomcat.sh' ;;
    *) return 1 ;;
  esac
}

cmd_diagnose() {
  local target="${1:-}"
  [ -n "$target" ] || ror_die 'diagnose requires a target'
  shift || true
  local script
  script="$(diagnostic_script "$target")" || ror_die "unknown diagnostic target: $target"
  cmd_run "$script" "$@"
}

cmd_collect() {
  local target="${1:-}"
  [ -n "$target" ] || ror_die 'collect requires a target'
  shift || true
  diagnostic_script "$target" >/dev/null 2>&1 || ror_die "unknown collection target: $target"
  local host stamp safe_target outfile rc
  host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf host)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  safe_target="$(printf '%s' "$target" | tr -c 'A-Za-z0-9._-' '_')"
  outfile="${ROR_COLLECT_OUTPUT:-./ror-collect-${safe_target}-${host}-${stamp}.txt}"

  printf 'Collecting %s diagnostic to %s\n' "$target" "$outfile"
  cmd_diagnose "$target" "$@" 2>&1 | tee "$outfile"
  rc=${PIPESTATUS[0]}
  printf '\nSaved: %s\n' "$outfile"
  return "$rc"
}

cmd_new() {
  local template="${1:-}" destination="${2:-}"
  [ -n "$template" ] && [ -n "$destination" ] || ror_die 'new requires <template> <destination>'
  template="${template#templates/}"
  local source="$ROR_HOME/templates/$template"
  [ -f "$source" ] || ror_die "template not found: templates/$template"
  [ ! -e "$destination" ] || ror_die "destination already exists: $destination"
  mkdir -p "$(dirname "$destination")"
  cp "$source" "$destination"
  printf 'Created %s from %s\n' "$destination" "templates/$template"
}

cmd_pkg_list() {
  local profile
  printf 'Available package profiles:\n'
  while IFS= read -r profile; do
    printf '  %-16s %s\n' "$profile" "$(ror_profile_description "$profile")"
  done < <(ror_profile_names)
}

cmd_pkg() {
  local action="${1:-list}" profile="${2:-troubleshooting}" manager missing external
  case "$action" in
    list)
      cmd_pkg_list
      ;;
    suggest)
      manager="$(ror_package_manager)"
      missing="$(ror_missing_profile_packages "$profile")"
      external="$(ror_missing_external_tools "$profile")"
      printf 'Profile/request: %s\n' "$profile"
      printf 'Package manager: %s\n' "$manager"
      printf 'Purpose: %s\n' "$(ror_profile_description "$profile")"

      if [ -n "$missing" ]; then
        printf '\nMissing package-managed items:\n'
        printf '%s\n' "$missing" | sed 's/^/  /'
        if [ "$manager" != 'unknown' ]; then
          # Package names are generated internally and contain no whitespace.
          # shellcheck disable=SC2086
          ror_install_command "$manager" $missing
        fi
      else
        printf '\nPackage-managed items: satisfied\n'
      fi

      if [ -n "$external" ]; then
        printf '\nExternal/vendor-specific tools still missing (not auto-installed):\n'
        printf '%s\n' "$external" | sed 's/^/  /'
      fi
      ;;
    install)
      manager="$(ror_package_manager)"
      [ "$manager" != 'unknown' ] || ror_die 'no supported package manager detected'
      missing="$(ror_missing_profile_packages "$profile")"
      if [ -n "$missing" ]; then
        printf 'Installing package-managed items for %s using %s:\n%s\n' "$profile" "$manager" "$missing"
        # Package names are generated internally and contain no whitespace.
        # shellcheck disable=SC2086
        ror_install_packages "$manager" $missing || ror_die 'package installation failed'
      else
        printf 'Package-managed items already satisfied for %s.\n' "$profile"
      fi

      external="$(ror_missing_external_tools "$profile")"
      if [ -n "$external" ]; then
        printf '\nNot automatically installed because setup is vendor/platform-specific:\n'
        printf '%s\n' "$external" | sed 's/^/  /'
      fi
      ;;
    *) ror_die 'pkg usage: ror pkg list|suggest|install [profile-or-package]' ;;
  esac
}

dotfile_group_valid() {
  ror_dotfiles_source_files "$1" >/dev/null 2>&1
}

dotfile_selected_groups() {
  local requested="${1:-all}"
  if [ "$requested" = 'all' ]; then
    ror_dotfiles_groups
  else
    dotfile_group_valid "$requested" || return 1
    printf '%s\n' "$requested"
  fi
}

cmd_dotfiles() {
  local action="${1:-status}" requested="${2:-all}" group backup_dir failed=0
  case "$action" in
    status)
      ror_dotfiles_status
      ;;
    diff)
      while IFS= read -r group; do
        ror_dotfiles_diff_group "$group"
        printf '\n'
      done < <(dotfile_selected_groups "$requested") || ror_die "unknown dotfile group: $requested"
      ;;
    install)
      [ -n "${2:-}" ] || ror_die 'dotfiles install requires <group|all>'
      dotfile_selected_groups "$requested" >/dev/null || ror_die "unknown dotfile group: $requested"
      backup_dir="$(ror_dotfiles_new_backup)"
      printf 'groups=%s\n' "$requested" >> "$backup_dir/meta"
      printf 'Backup: %s\n' "$(basename "$backup_dir")"

      while IFS= read -r group; do
        printf 'Installing %s dotfiles...\n' "$group"
        if ror_dotfiles_install_group "$backup_dir" "$group"; then
          printf '  installed\n'
        else
          printf '  failed or unsupported\n' >&2
          failed=1
        fi
      done < <(dotfile_selected_groups "$requested")

      printf '\nUse `ror dotfiles restore %s` to restore the exact pre-install state.\n' "$(basename "$backup_dir")"
      [ "$failed" -eq 0 ] || return 1
      ;;
    backups)
      ror_dotfiles_list_backups
      ;;
    restore)
      ror_dotfiles_restore "${2:-latest}"
      ;;
    *)
      ror_die 'dotfiles usage: ror dotfiles status|diff [group|all]|install <group|all>|backups|restore [latest|backup-id]'
      ;;
  esac
}

cmd_update() {
  ror_have git || ror_die 'git is required for update'
  [ -z "$(git -C "$ROR_HOME" status --porcelain)" ] || ror_die 'working tree is not clean; refusing to update'
  git -C "$ROR_HOME" pull --ff-only
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  doctor) shift; cmd_doctor "$@" ;;
  info) cmd_info ;;
  path) shift; cmd_path "$@" ;;
  find|search) shift; cmd_find "$@" ;;
  cheat|cheatsheet) shift; cmd_cheat "$@" ;;
  diagnose|diag) shift; cmd_diagnose "$@" ;;
  collect) shift; cmd_collect "$@" ;;
  run) shift; cmd_run "$@" ;;
  new) shift; cmd_new "$@" ;;
  pkg) shift; cmd_pkg "$@" ;;
  dotfiles) shift; cmd_dotfiles "$@" ;;
  update) cmd_update ;;
  *) usage; exit 1 ;;
esac
