# Machine-local state: never commit anything under local/ except its guide/placeholders.
/local/*
!/local/README.md
!/local/.gitkeep

# Environment and credentials
*.env
*.key
*.p12
*.pfx
*.jks
*.kdb
*.pem.key

# ROR-generated collection output
ror-collect-*.txt

# Common generated/local state
*.log
*.swp
.DS_Store
Thumbs.db
