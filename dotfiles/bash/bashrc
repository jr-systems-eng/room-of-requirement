# Room of Requirement - portable Bash defaults
# Loaded as a managed fragment from ~/.bashrc.

# Interactive shells only.
case $- in
  *i*) ;;
  *) return ;;
esac

# Prefer user-local commands without duplicating PATH entries.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Useful history behavior across jumpboxes/workstations.
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend
shopt -s checkwinsize

# Portable convenience aliases.
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Local, machine-specific customizations are intentionally not committed.
ROR_BASH_LOCAL="${XDG_CONFIG_HOME:-$HOME/.config}/ror/local/bashrc"
if [ -r "$ROR_BASH_LOCAL" ]; then
  . "$ROR_BASH_LOCAL"
fi
unset ROR_BASH_LOCAL
